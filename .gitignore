# SQL Server database files and backups
*.mdf
*.ldf
*.ndf
*.bak
*.dbmdl

# Azure and publishing
*.pubxml
*.azurePubxml
*.publishproj
PublishScripts/
*.publishsettings
*.pfx
publish/

# Node.js
node_modules/
.ntvs_analysis.dat

# Python
**/__pycache__/
*.pyc

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# Other temporary and backup files
~$*
*~
*.tmp
*.temp
Backup*/
_UpgradeReport_Files/
UpgradeLog*.XML
UpgradeLog*.htm
MigrationBackup/
healthchecksdb

# Windows installer outputs
*.cab
*.msi
*.msix
*.msm
*.msp

