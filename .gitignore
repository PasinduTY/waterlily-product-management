## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore


# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Environment files and secrets
.env
.env.*
!.env.example

# Local application settings
appsettings.Local.json
appsettings.Development.Local.json

# Mono
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Aa][Rr][Mm]64[Ee][Cc]/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
**/[Bb]in/*
bin/x64/
bin/x86/
obj/x64/
obj/x86/
artifacts/
.artifacts/

# Visual Studio
.vs/
.idea/
Generated Files/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.VisualState.xml
TestResult.xml
nunit-*.xml

# .NET
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg

# NuGet packages
**/[Pp]ackages/*
!**/[Pp]ackages/build/

