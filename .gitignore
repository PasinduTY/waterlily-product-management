*.psess
*.vsp
*.vspx
*.sap
*.e2e
*.binlog
MSBuild_Logs/

# ReSharper and other IDE tools
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
_TeamCity*
*.dotCover
.axoCover/*
!.axoCover/settings.json
_NCrunch_*
.NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*
OpenCover/
**/.localhistory/
.vshistory/
**/.cr/personal
**/.mfractor/
