@model WaterlilyProductManagement.ViewModels.Products.ProductListItemViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <h2 class="mb-4">Delete Product</h2>

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="alert alert-warning">
                        Are you sure you want to delete this product?
                        This action cannot be undone.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Product ID</dt>
                        <dd class="col-sm-8">@Model.ProductId</dd>

                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.Category</dd>

                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8">@Model.Price.ToString("N2")</dd>

                        <dt class="col-sm-4">Stock</dt>
                        <dd class="col-sm-8">@Model.Stock</dd>
                    </dl>

                    <form asp-action="Delete"
                          asp-route-id="@Model.ProductId"
                          method="post">

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit" class="btn btn-danger">
                                Confirm Delete
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
