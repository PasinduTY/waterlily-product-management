@model WaterlilyProductManagement.ViewModels.Reports.ReportViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">

    <h2 class="mb-4">Product Reports</h2>

    <!-- Highest Stock Value Category -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="card-title mb-3">
                Highest Stock Value Category
            </h4>

            @if (Model.HighestStockValueCategory is null)
            {
                <div class="alert alert-info mb-0">
                    No product data is available to generate this report.
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted mb-1">Category</p>
                        <h5>
                            @Model.HighestStockValueCategory.Category
                        </h5>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted mb-1">Total Stock Value</p>
                        <h5>
                            @Model.HighestStockValueCategory.TotalStockValue.ToString("N2")
                        </h5>
                    </div>
                </div>
            }

        </div>
    </div>

    <!-- Average Price by Category -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="card-title mb-3">
                Average Price by Category
            </h4>

            @if (!Model.CategoryAverages.Any())
            {
                <div class="alert alert-info mb-0">
                    No product data is available to generate this report.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-striped align-middle mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th>Category</th>
                                <th>Average Price</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.CategoryAverages)
                            {
                                <tr>
                                    <td>@item.Category</td>
                                    <td>@item.AveragePrice.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
